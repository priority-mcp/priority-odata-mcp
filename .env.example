# Priority MCP Server — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# All variables have safe defaults except those marked REQUIRED.

# =============================================================================
# REQUIRED — Priority API Connection
# =============================================================================

# OData service root URL for your Priority ERP instance.
# Format: https://<host>/odata/Priority/<tabula.ini-file>/<company>/
# For Docker on the same machine: https://host.docker.internal/odata/Priority/tabula.ini/demo/
PRIORITY_BASE_URL=https://your-priority-host/odata/Priority/tabula.ini/demo/

# Authentication method. Choose one of: basic | pat | oauth2 | none
# 'none' is not recommended; use only for local testing without network exposure.
PRIORITY_AUTH_TYPE=basic

# Basic auth credentials (required when PRIORITY_AUTH_TYPE=basic)
PRIORITY_USERNAME=your_username
PRIORITY_PASSWORD=your_password

# =============================================================================
# REQUIRED — MCP Server Security
# =============================================================================

# Bearer token that protects the MCP HTTP endpoint.
# ALL requests to /mcp (and other protected routes) must include:
#   Authorization: Bearer <value>
# If not set, a random token is generated at startup and printed to stdout.
# For production, always set this to a strong random secret.
# Generate one with: node -e "console.log(require('crypto').randomUUID())"
ODATA_MCP_TOKEN=your-strong-random-secret

# =============================================================================
# OPTIONAL — Additional Priority Auth Methods
# =============================================================================

# Personal Access Token (required when PRIORITY_AUTH_TYPE=pat or oauth2)
# PRIORITY_PAT=your_personal_access_token

# Per-application license credentials (optional; for app-specific licensing)
# PRIORITY_APP_ID=your_app_id
# PRIORITY_APP_KEY=your_app_key

# Language/locale override for Priority API responses (optional)
# PRIORITY_LANGUAGE=en

# =============================================================================
# OPTIONAL — TLS & Timeouts
# =============================================================================

# Reject invalid/self-signed TLS certificates.
# Set to 'true' for production. 'false' allows self-signed certs (dev/staging only).
TLS_REJECT_UNAUTHORIZED=false

# HTTP request timeout for Priority API calls, in milliseconds. Default: 30000 (30s)
PRIORITY_HTTP_TIMEOUT_MS=30000

# Timeout for write operations (POST/PATCH/DELETE), in milliseconds. Default: 15000 (15s)
MCP_WRITE_TIMEOUT=15000

# Timeout for procedure/action operations, in milliseconds. Default: 45000 (45s)
MCP_PROC_TIMEOUT=45000

# =============================================================================
# OPTIONAL — HTTP Server
# =============================================================================

# Bind address for the MCP HTTP server. Default: 0.0.0.0 (all interfaces)
HTTP_HOST=0.0.0.0

# Port for the MCP HTTP server. Default: 3000
HTTP_PORT=3000

# Enable Server-Sent Events (SSE) transport in addition to streamable HTTP.
# Set to 'true' to enable /sse endpoint. Default: false
SSE_ENABLED=false

# =============================================================================
# OPTIONAL — Data Integrity
# =============================================================================

# Enforce strict data integrity checks on all tool results.
# When 'true': runtime validation on all API responses; no mock data allowed.
# When 'false': basic error handling only (not recommended for production).
STRICT_DATA_INTEGRITY=true

# =============================================================================
# ADVANCED — Debugging & Logging
# =============================================================================

# Log level for the MCP server. Values: INFO | DEBUG. Default: INFO
# DEBUG prints every request/response method; INFO suppresses noisy housekeeping calls.
LOG_LEVEL=INFO

# Enable detailed MCP debug logging for Priority API calls.
# Prints full request URLs, query params, response counts, and date validation.
# Values: true | false. Default: false
MCP_DEBUG=false

# Alias for MCP_DEBUG (either variable enables debug logging).
# DEBUG=false

# Enable request tracing in the Priority API client.
# Values: true | false. Default: false
PRIORITY_ENABLE_TRACE=false

# Override the path to the .env file to load.
# Useful when this server is deployed as a submodule inside a larger project.
# When set, takes precedence over all automatic .env discovery.
# ENV_FILE_PATH=/path/to/custom/.env

# =============================================================================
# Notes
# =============================================================================
#
# 1. Docker deployments:
#    Use 'host.docker.internal' in PRIORITY_BASE_URL to reach services on the host machine.
#    Environment variables can be passed with --env-file .env or -e KEY=VALUE.
#
# 2. Authentication methods:
#    basic   → PRIORITY_USERNAME + PRIORITY_PASSWORD
#    pat     → PRIORITY_PAT (Personal Access Token)
#    oauth2  → PRIORITY_PAT (OAuth2 Bearer Token)
#    none    → No auth (local testing only — never expose without ODATA_MCP_TOKEN)
#
# 3. Security checklist for production:
#    ✓ ODATA_MCP_TOKEN is set to a strong random value
#    ✓ TLS_REJECT_UNAUTHORIZED=true
#    ✓ HTTP_HOST is restricted (e.g., 127.0.0.1) if not behind a reverse proxy
#    ✓ .env file has 600 permissions and is never committed to version control
