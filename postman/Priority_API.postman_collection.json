	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Get CSRF Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extract CSRF token and session cookie",
									"const csrfToken = pm.response.headers.get('X-CSRF-Token');",
									"const setCookie = pm.response.headers.get('Set-Cookie');",
									"",
									"if (csrfToken) {",
									"    pm.environment.set('csrf_token', csrfToken);",
									"    console.log('CSRF Token saved:', csrfToken);",
									"}",
									"",
									"if (setCookie) {",
									"    const cookie = setCookie.split(';')[0];",
									"    pm.environment.set('session_cookie', cookie);",
									"    console.log('Session cookie saved:', cookie);",
									"}",
									"",
									"pm.test('CSRF token retrieved', function () {",
									"    pm.expect(csrfToken).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-CSRF-Token",
								"value": "Fetch"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{priority_base_url}}",
							"host": [
								"{{priority_base_url}}"
							]
						},
						"description": "Get CSRF token and session cookie for write operations"
					},
					"response": []
				},
				{
					"name": "Test Connection",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is JSON', function () {",
									"    pm.response.to.be.json;",
									"});",
									"",
									"pm.test('Service document has entities', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('value');",
									"    pm.expect(jsonData.value).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{priority_base_url}}?$format=json",
							"host": [
								"{{priority_base_url}}"
							],
							"query": [
								{
									"key": "$format",
									"value": "json"
								}
							]
						},
						"description": "Test connection and get service document (list of all entities)"
					},
					"response": []
				}
			],
			"description": "Authentication and connection testing"
		},
