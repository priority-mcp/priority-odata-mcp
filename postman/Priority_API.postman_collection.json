				{
					"name": "Create Customer",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Ensure CSRF token is available",
									"if (!pm.environment.get('csrf_token')) {",
									"    pm.sendRequest({",
									"        url: pm.environment.get('priority_base_url'),",
									"        method: 'GET',",
									"        header: {",
									"            'X-CSRF-Token': 'Fetch'",
									"        }",
									"    }, function (err, res) {",
									"        if (!err) {",
									"            const csrfToken = res.headers.get('X-CSRF-Token');",
									"            const setCookie = res.headers.get('Set-Cookie');",
									"            if (csrfToken) pm.environment.set('csrf_token', csrfToken);",
									"            if (setCookie) pm.environment.set('session_cookie', setCookie.split(';')[0]);",
									"        }",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "X-CSRF-Token",
								"value": "{{csrf_token}}"
							},
							{
								"key": "Cookie",
								"value": "{{session_cookie}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"CUSTNAME\": \"New Customer\",\n    \"CUSTDES\": \"Customer Description\",\n    \"EMAIL\": \"customer@example.com\"\n}"
						},
						"url": {
							"raw": "{{priority_base_url}}CUSTOMERS",
							"host": [
								"{{priority_base_url}}"
							],
							"path": [
								"CUSTOMERS"
							]
						},
						"description": "Create a new customer"
					},
					"response": []
				},
